{
  "name": "lumina-calendar",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Calendario local-first donde cada evento es una carpeta de tareas anidables.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
